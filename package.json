{
  "name": "qr-menu-template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Production-ready static QR menu template for restaurants and cafes",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate && npm run generate:meta && tsc --noEmit && vite build",
    "prepare:assets": "node scripts/create-demo-assets.js",
    "preview": "vite preview",
    "validate": "node scripts/validate-menu.js",
    "generate:meta": "node scripts/generate-meta.js",
    "generate:qr": "node scripts/generate-qr.js",
    "optimize:images": "node scripts/optimize-images.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.29.0",
    "vite": "^6.3.3",
    "vitest": "^3.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
